@incollection{hachetteMobilityHubsInnovative2023,
  title = {Mobility {{Hubs}}, an {{Innovative Concept}} for {{Sustainable Urban Mobility}}?},
  booktitle = {Smart {{Cities}}},
  author = {Hachette, Maxime and L'hostis, Alain},
  date = {2023-10},
  series = {Studies in {{Energy}}, {{Resource}} and {{Environmental Economics}}},
  pages = {245--278},

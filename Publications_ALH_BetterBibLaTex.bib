@unpublished{vanbezooijenIdentifyingBarriersOpportunities2027,
  title = {Identifying {{Barriers}} and {{Opportunities}} to the 15 Minute City in {{European Urban Outskirts}}},
  author = {family=Bezooijen, given=Dylan, prefix=van, useprefix=true and Arias Molinares, Daniela and Geurs, Karst T. and Bobičic, Ognjen and Grigolon, Anna and Ulak, Mehmet Baran and Charalampidou, Georgia and Caixeta, Ana Clara and McCormick, Bartosz and Duran-Rodas, David and Susilo, Yusak Octavius and Dörrzapf, Linda and family=Vessem, given=Charlotte, prefix=van, useprefix=true and Keserű, Imre and Geertman, Stephanie and Adjeroud, Heythem and L'Hostis, Alain},
  date = {2027},
  abstract = {The 15-minute city (15mC) concept has gained widespread policy attention, yet its applicability to urban outskirts remains largely unexplored. This study uses a cross-European survey across six cities (Paris, Brussels, Munich, Vienna, Budapest, and Utrecht), with over 2,500 responses, to identify barriers and opportunities for achieving a 15mC in European urban outskirts. The analysis employs ordered logit modelling and latent class analysis. The ordered logit model shows that residents in urban outskirts perceive systematically lower accessibility than those in urban cores. High-income respondents have higher odds of reporting better access than low-income respondents, while access to a bicycle or public transport is positively associated with perceived accessibility. Conversely, difficulties with walking or cycling are negatively associated with perceived accessibility. Reported barriers in urban outskirts are multifaceted, including services being too far away, difficulties reaching destinations by transport, and unsafe or congested traffic conditions. Transport improvements most desired by residents relate to public transport, while shared mobility solutions are selected relatively infrequently. Latent class analysis suggests that differences in amenity preferences did not translate into significantly different perceptions of accessibility, despite wide variety in access to different types of amenities. Suggesting that broad lifestyle profiles may be less relevant in explaining perceived accessibility than specific individual characteristics and mobility constraints.},
  keywords = {DBSCAN,Non-Commute Activities,Public Transportation Big Data,Spatiotemporal Characteristics,Voronoi Diagram}
}

@article{vulturescuSimulationTempsParcours2011,
  title = {Simulation des temps de parcours du transport ferroviaire régional du bassin de vie stéphanois dans le cadre du projet Bahn.Ville},
  author = {Vulturescu, Bogdan and L’Hostis, Alain and Soulas, Claude},
  date = {2011-11-01},
  journaltitle = {Recherche Transports Sécurité},
  shortjournal = {Rech. Transp. Sécurité},
  volume = {27},
  number = {4},
  pages = {283--297},
  issn = {1951-6614},
  doi = {10.1007/s13547-011-0027-z},
  url = {https://doi.org/10.1007/s13547-011-0027-z},
  urldate = {2025-03-03},
  abstract = {Le projet de recherche franco-allemand Bahn.Ville, urbanisme orienté vers le rail et intermodalité dans les régions urbaines allemandes et françaises, a consisté à identifier les principes et facteurs de succès d’un urbanisme orienté vers le rail et de les tester sur un terrain d’expérimentation, l’agglomération de Saint-Étienne. Une des recherches-actions a consisté à identifier et à anticiper les impacts possibles en termes urbains d’un nouveau système de transport de type tram-train prenant appui sur une ligne existante. Un des critères de la grille d’évaluation des nouveaux arrêts envisagés est l’impact de l’introduction d’un nouvel arrêt sur les temps de parcours futurs. Dans cet article, nous présenterons une méthode de simulation des temps de parcours et nous nous efforçons d’en montrer l’intérêt et les limites vis-à-vis du choix du matériel ainsi que du choix de l’implantation de nouvelles stations.},
  langid = {french},
  keywords = {Journey time simulation,Performances matériel roulant,Rolling stock performances,Simulation des temps de parcours,Tram-train,Urban development,Urbanisme},
  annotation = {HAL: hal-00835225}
}


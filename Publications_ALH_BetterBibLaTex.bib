@unpublished{bobicicProximityExtending15minute2027,
  title = {Beyond Proximity in Extending the 15-Minute City Concept to {{European}} Urban Outskirts through Shared Mobility},
  author = {Bobičic, Ognjen and Charalampidou, Georgia and Susilo, Yusak Octavius and Geurs, Karst T. and Ulak, Mehmet Baran and Duran-Rodas, David and L'Hostis, Alain and Adjeroud, Heythem and Guitton, Élie and Esztergár-Kiss, Domokos},
  date = {2027},
  abstract = {How can the 15-minute city be realized in urban outskirts, where essential destinations are dispersed, and frequent public transport cannot be taken for granted? In these settings shared mobility may help bridge the accessibility gap to everyday activities by expanding the range of reachable destinations. This study examines under which activity, travel, and service conditions shared mobility can contribute to accessibility in five European urban-outskirt case studies in Brussels (Belgium), Budapest (Hungary), Munich (Germany), Paris (France), and Utrecht (Netherlands). The analysis draws on 1,266 survey respondents and defines preferences across tailored mobility scenarios linked to the activity considered most important. Mixed Logit models captured heterogeneity in sensitivities to travel attributes and service functionalities, while extended specifications tested activity–mode interactions. Across the five study areas, grocery shopping was the most frequently prioritized activity. The attractiveness of transport alternatives varied, with bicycle-sharing as the most attractive shared transport mode. Travel time was the most consistent determinant of choice, whereas the effects of cost, access time, and service functionalities were context dependent. For example, protected cycling infrastructure increased the attractiveness of shared services in Paris, while parking opportunities improved shared-moped utility in Utrecht. Activity interactions showed that walking and shared modes were valued differently for grocery, leisure, health, and commerce trips across locations. The findings suggest that shared mobility can complement walking and public transport in urban outskirts, but its potential depends on how well the transport mode and service design respond to specific local accessibility needs},
  keywords = {DBSCAN,Non-Commute Activities,Public Transportation Big Data,Spatiotemporal Characteristics,Voronoi Diagram}
}

@article{bounieWhatValueTravelers2019,
  title = {What Value Do Travelers Put on Connectivity to Mobile Phone and {{Internet}} Networks in Public Transport? {{Empirical}} Evidence from the {{Paris}} Region},
  shorttitle = {What Value Do Travelers Put on Connectivity to Mobile Phone and {{Internet}} Networks in Public Transport?},
  author = {Bounie, Nathan and Adoue, François and Koning, Martin and L'Hostis, Alain},
  date = {2019},
  journaltitle = {Transportation Research Part A: Policy and Practice},
  shortjournal = {Transp. Res. Part Policy Pract.},
  volume = {130},
  pages = {158--177},
  issn = {0965-8564},
  doi = {10/ggw568},
  url = {http://www.sciencedirect.com/science/article/pii/S0965856418311960},
  urldate = {2019-09-25},
  abstract = {Unlike the drivers of private vehicles, public transport (PT) users may perform secondary tasks during their primary travel activity. Moreover, Information and Communication Technologies may open up “multi-tasking” possibilities by allowing individuals to spend their travel time in more pleasant ways. This article proposes a tentative valuation of connectivity to mobile phone and Internet networks (MPIN) in PT, based on the stated preferences of 501 inhabitants of the Paris region. The surveyed individuals were presented with hypothetical trade-offs between travel time reductions and improvements in MPIN connectivity in PT. Econometric tests show that the values ascribed to better connectivity are higher when PT users perform various tasks with smartphones or tablets during their trips and when they experience a large number of connectivity problems in the reference situation. While heterogeneity between individuals has a minor direct impact, we propose a typology of PT users that captures variations in valuations. On average, the subjective value of travel time would be reduced by 12\% if PT users benefited from optimal MPIN connectivity whilst traveling. Alternative “time multipliers” – for types of PT user, gradual connectivity improvements, different device-based tasks – are also proposed. Lastly, we apply our results to a cost-benefit analysis of a current project in the Paris region PT.},
  keywords = {Connectivity,Mobile phone and Internet networks,Public transport,Stated preferences,Time multipliers,Travel-based multi-tasking,Value of the travel time},
  annotation = {HAL: hal-02299150},
  file = {/home/lhostis/Zotero/storage/JVSJRZMH/Bounie et al. - 2019 - What value do travelers put on connectivity to mob.pdf;/home/lhostis/Zotero/storage/QZGFPBA2/S0965856418311960.html}
}


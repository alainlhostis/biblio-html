  keywords = {accessibilit\'e,accessibilité,Accessibilité,enc,Intermodalit\'e,Intermodalité,m\'etropolisation,métropolisation,Métropolisation,Transport a\'erien,Transport aérien,Transport ferroviaire \`a grande vitesse,Transport ferroviaire à grande vitesse},
  annotation = {HAL:tel-00294581},
  note = {Direction : Ph. Menerault,A. L'Hostis},

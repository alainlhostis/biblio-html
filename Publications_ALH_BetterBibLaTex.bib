@unpublished{kanRethinking15minuteCity2027,
  title = {Rethinking the 15-Minute City after Dark: {{Assessing}} Day–Night Dynamics of Urban Service Accessibility and Diversity from Eight {{Chinese}} Cities},
  author = {Kan, Zihan and Wei, Jiaomin and Kwan, Mei-Po and Liu, Dong and L'Hostis, Alain},
  date = {2027},
  abstract = {Access to urban services is essential for residents’ social participation and inclusive urban development. As urban activities extend beyond conventional working hours, evaluating nighttime service provision becomes increasingly important within the 15-minute city framework. However, conventional assessments often overlook nocturnal contexts, like facility opening hours and population mobility, constraining insights into how the day-night transition reshapes 15-minute walking accessibility and service diversity. Using the Gaussian two-step floating catchment area (G2SFCA) method, this study develops a dynamic framework to compares day–night accessibility and diversity across eight Chinese cities, complemented by joint service profiles, inequality measures, and supply-demand decomposition for day-night accessibility changes. The results reveal that nighttime accessibility and diversity remain at approximately 54\% and 82\% of their daytime levels, respectively. Only 52\% of daytime high-accessibility, high-diversity grids retain this profile at night, while 99\% of low-accessibility, low-diversity grids remain in the same category. Shenzhen retains comparatively extensive joint service advantages, whereas peripheral disadvantages are pronounced in several inland and northeastern cities. The supply–demand decomposition attributes nighttime accessibility losses primarily to operating-supply contraction, partially offset by reduced population volume, while population redistribution produces contrasting local effects. These findings extend the 15-minute city framework to nighttime, provide empirical foundation for identifying where and how daytime urban service remain at night.},
  keywords = {DBSCAN,Non-Commute Activities,Public Transportation Big Data,Spatiotemporal Characteristics,Voronoi Diagram}
}

@unpublished{kanRethinking15minuteCity2027a,
  title = {Activity‑{{Space Reorganization}} of {{Metro Mobility Under Extreme Typhoon Weather Revealed}} by {{Weighted Spatial Statistics}} of {{Mobile Phone Signaling Data}}},
  author = {Liu, Dong and L'Hostis, Alain},
  date = {2027},
  abstract = {Extreme weather events can substantially disrupt urban mobility, yet their impacts extend beyond changes in metro ridership to the spatial reorganization of population activities around stations. This study investigates the effects of Typhoon Wipha on metro-related population mobility in Shenzhen using mobile phone signaling data. Three comparable four-day periods were selected to represent the reference, normal, and typhoon-affected conditions. Passenger flow ratios were used to quantify changes in travel demand, while population- and distance-weighted activity centers and Standard Deviational Ellipses (SDEs) were employed to characterize the temporal displacement and spatial extent of population activities within metro station service areas. K-means clustering was further applied to examine heterogeneous responses among different station types. Results show that metro-related travel activity declined substantially on July 20, accompanied by a marked contraction of SDEs, indicating a more spatially concentrated activity pattern. Meanwhile, cumulative activity-center displacement increased in many station service areas, revealing greater hour-to-hour spatial redistribution, with particularly pronounced changes in Pingshan District. Mobility patterns largely recovered on July 21. Three station types—low-intensity, employment-oriented, and residential-oriented—exhibited distinct activity patterns, while their relative spatial differences remained broadly stable during the typhoon. These findings reveal that typhoons affect not only travel demand but also the spatial extent and temporal stability of metro-related population activities, providing a more comprehensive basis for differentiated metro resilience planning and emergency management.},
  keywords = {DBSCAN,Non-Commute Activities,Public Transportation Big Data,Spatiotemporal Characteristics,Voronoi Diagram}
}

@article{kloecknerContextualMetricsMathematical2020,
  title = {Contextual {{Metrics}} a {{Mathematical Definition}} for a {{Comprehensive Approach}} of {{Geographical Distances}}},
  author = {Kloeckner, Benoît R. and L'Hostis, Alain and Richard, Thomas},
  date = {2020},
  journaltitle = {Geographical Analysis},
  shortjournal = {Geogr. Anal.},
  volume = {53},
  number = {4},
  pages = {736--766},
  issn = {1538-4632},
  doi = {10/gjqhf5},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/gean.12260},
  urldate = {2021-04-15},
  abstract = {Our goal is to establish a mathematical framework for the description of geographical distance in a comprehensive way. Geographical distance always refer to potential or realized movement between places, and these displacements obey the least effort rule. While this optimization of effort is well known to imply the Triangle Inequality in many situation, breaks in movement generate a paradox: effort optimization, taking into account the need to rest, results in apparent violations of the Triangle Inequality. In order to solve this issue, we introduce contextual metrics that consider space but also any contextual information relevant to travel, such as resources used for moving. Our approach permits to build a subjective space where distances are affected by the characteristics of the individual on the move. Contextual metrics frame the optimization problem in a space enriched by the context that the traveler has to take into account, making apparent that the violation of the Triangle Inequality in case of break was only an artifact of a model lacking crucial information. The range of geographical situations that can be modeled with this framework underline the level of generalization that can be expected from this approach.},
  langid = {english},
  annotation = {HAL: hal-02147263}
}


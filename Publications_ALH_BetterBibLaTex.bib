@incollection{lhostisTheoreticalModelsTimeSpace2013,
  title = {Theoretical {{Models}} of {{Time-Space}}: {{The Role}} of {{Transport Networks}} in the {{Shrinking}} and {{Shrivelling}} of {{Geographical Space}}},

@online{lhostis15minuteCitiesNeed2026,
  title = {Beyond ”15-Minute Cities”, the Need to Connect at the Agglomeration Scale},
  author = {L'Hostis, Alain},
  date = {2026-05},
  url = {https://www.expertises-territoires.fr/jcms/123055897_BlogPost/en/beyond-15-minute-cities-the-need-to-connect-at-the-agglomeration-scale},
  urldate = {2026-05-13},
  abstract = {Barcelona has been at the forefront of the global 15-minute city movement, pioneering the concept and implementation of superilles (superblocks) since 2014. As Lamiquiz et al. (2025) highlight, the city’s evaluation of superblocks’ impact led to a significant evolution in its 2024 Mobility Plan (PMU): the introduction of agglomeration-scale green axes (Ejes Verdes), designed to connect superblocks into a cohesive network. What’s particularly compelling is how Barcelona’s superblocks — local implementation of the 15-minute city model — are now being complemented by this longer-distance network approach. This resonates with the classic Transit-Oriented Development (TOD) corridors, as in the necklace of pearls idea (Arrington et al 2008, p 73). After all, Calthorpe (1993) himself introduced TOD after first theorizing the pedestrian pocket, underscoring that urbanism is, by definition, multi‑scale. This development also enriches the broader debate on 15-minute cities. In February 2024, I had the opportunity of joining Carlos Moreno on a guided tour of Paris’s Olympiades-Batignolles district, a model 15-minute neighbourhood. Standing outside the iconic Pont-Cardinet metro station, I asked Carlos about the role of transit in the 15-minute city framework — and its connection to TOD. His response was clear: transit should remain secondary in the model, with the primary focus on proximity. The convergence — and divergence — of these urban models is fascinating. In Barcelona, the green axes (or streets for the 21st century) prioritize walking, cycling, and placemaking, while explicitly integrating public transport planning. This holistic policy suite outlines the contours of an urban model that warrants further research — and perhaps even theoretical formalization.},
  organization = {Expertises Territoires: 15-in cities Bringing more proximity in cities},
  keywords = {15-minute cities,TOD Transit-Oriented Development},
  annotation = {HAL:hal-05621808},
  file = {/home/lhostis/Zotero/storage/5P95ZPHG/hal-05621808.html}
}

@unpublished{lhostis15minuteCityNew2023,
  title = {The 15-Minute City : A New Avatar of Proximity and a Pillar of the {{European}} Urban Transition},
  shorttitle = {The 15-Minute City},
  author = {L'Hostis, Alain and Cissé, Ndèye Aïta and Hachette, Maxime},
  date = {2023-10-11},
  url = {https://zenodo.org/records/10047697},
  urldate = {2023-12-01},
  abstract = {Our contribution aims at building bridges between academics and practitioners (NGOs, Public authorities, and social entrepreneurs) through an adaptative and inclusive knowledge hub on 15-min cities. This endeavor faces several problems linked to the lack of interconnection between the stakeholders 'experiences and the lack of tools, and dedicated studies. These problems tend to weaken~the decision-making. Our main effort addresses the need for a knowledge polarization and for a common space to share experiences.~The present contribution presents a synthesis of the knowledge presented in a "scientific seminar open to practitioners" held in Milano in 2023. This synthesis could benefit practitioners by facilitating the access to the knowledge produced. This synthesis may also indicate avenues for future research. The synthesis is organized in five themes: the definition of 15-minute city, proximity according to a specific mode, the planification based on the 15-minute city principles, examples of inclusivity in a 15-minute city, and evaluation of the 15-minute city.},
  langid = {english},
  venue = {Antwerp},
  keywords = {presentation},
  annotation = {Zenodo: 10047697},
  file = {/home/lhostis/Zotero/storage/D5BDLS7N/The 15-minute city  a new avatar of proximity and.pdf}
}


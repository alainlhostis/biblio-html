@article{lhostisWhatShapeGeographical2021,
  title = {What {{Is}} the {{Shape}} of {{Geographical Time-Space}}? {{A Three-Dimensional Model Made}} of {{Curves}} and {{Cones}}},
  shorttitle = {What {{Is}} the {{Shape}} of {{Geographical Time-Space}}?},
  author = {L'Hostis, Alain and Abdou, Farouk},
  date = {2021},
  journaltitle = {ISPRS International Journal of Geo-Information},
  shortjournal = {ISPRS Int. J. Geo-Inf.},
  volume = {10},
  number = {5},
  pages = {340},
  publisher = {Multidisciplinary Digital Publishing Institute},
  doi = {10/gkcwsx},
  url = {https://www.mdpi.com/2220-9964/10/5/340},
  urldate = {2021-06-03},
  abstract = {Geographical time-spaces exhibit a series of properties, including space inversion, that turns any representation effort into a complex task. In order to improve the legibility of the representation and leveraging the advances of three-dimensional computer graphics, the aim of the study is to propose a new method extending time-space relief cartography introduced by Mathis and L’Hostis. The novelty of the model resides in the use of cones to describing the terrestrial surface instead of graph faces, and in the use of curves instead of broken segments for edges. We implement the model on the Chinese space. The Chinese geographical time-space of reference year 2006 is produced by the combination and the confrontation of the fast air transport system and of the 7.5-times slower road transport system. Slower, short range flights are represented as curved lines above the earth surface with longer length than the geodesic, in order to account for a slower speed. The very steep slope of cones expresses the relative difficulty of crossing terrestrial time-space, as well as the comparably extreme efficiency of long-range flights for moving between cities. Finally, the whole image proposes a coherent representation of the geographical time-space where fast city-to-city transport is combined with slow terrestrial systems that allow one to reach any location.},
  eid = {5},
  langid = {english},
  keywords = {cartography,geographical time-space,transport},
  annotation = {HAL: hal-03466923},
  note = {0 citations (Semantic Scholar/DOI) [2021-06-03]}
}

@unpublished{lhostisWhatSizeTransit2026,
  title = {What Is the Size of Transit Neighborhoods? {{An}} Analysis of the Academic and Operational {{Transit-Oriented Development}} ({{TOD}}) Literature on {{Station Area Delineation}}},
  shorttitle = {What Is the Size of Transit Neighborhoods?},
  author = {L'Hostis, Alain and Cissé, Ndèye Aïta and Moinse, Dylan},
  date = {2026},
  url = {https://hal.science/hal-05576915},
  urldate = {2026-04-22},
  abstract = {In the definition of TOD, one of the important methodological challenges lies in defining the observation and intervention radiuses around transport stops. In the TOD literature, the most commonly accepted reference is the half-mile (800 meters) proposed in the first definition of TOD by Calthorpe (1993). The neighborhood is defined as a pedestrian area ("pedestrian pocket"). Calthorpe explicitly refers to pedestrians and retains the half-mile as equivalent to 10 minutes of walking. We review the definition of radiuses to define stations districts in the academic and operational literature on TOD. Two approaches are possible to define station neighborhoods: either by analyzing urban dynamics, or by analyzing mobility. The literature review shows that the argument of mobility is most often invoked to justify the size of the radius. The findings of this literature review are as follows: The use of half-mile, i.e. 800 meters, can be recommended as a reference for the analysis and orientation of action on station radiuses.  A relevant analysis can use a set of concentric radii: • 400 meters for urban density and mix, as well as for the ease of pedestrian movement. • 800 meters as the reference space for TOD analysis with an emphasis on urban density. • Beyond that, to capture residential dynamics and the intermodal interaction of pedestrian, cycling, and other forms of micromobility with public transportation, measures from 2,000 to 2,700 meters (1.25 to 1.67 miles) are used in the literature. In addition to the issue of the radius, addressing the transit Station Area Delineation problem engages using buffers (mathematical circles) in dialogue with isochrones computations and representations (geographical circles).},
  keywords = {Buffer,Half-Mile,Isochrone,Transit Area Delineation,Transit-Oriented Development},
  annotation = {HAL:hal-05576915},
  note = {working paper or preprint},
  file = {/home/lhostis/Zotero/storage/KW53YYYX/L'Hostis et al. - 2026 - What is the size of transit neighborhoods An analysis of the academic and operational Transit-Orien.pdf}
}

@inproceedings{lhuillierInfluenceDifferentCartographic2025,
  title = {The Influence of Different Cartographic Materials on the Cognitive Processing of Geographical Time-Space: An Empirical Study},
  shorttitle = {The Influence of Different Cartographic Materials on the Cognitive Processing of Geographical Time-Space},
  booktitle = {{{SMW2025}} : 4th {{Schematic Mapping Workshop}}},
  author = {Lhuillier, Simon and L'hostis, Alain and Gyselinck, Valérie},
  date = {2025-04},
  location = {Paris, France},
  url = {https://hal.science/hal-05044455},
  urldate = {2026-01-21},
  abstract = {Geographers employ various techniques to represent the multiple dimensions of geographical time-space through maps. For example, precise cartographic transformations can be applied to distort spatial extents, enhancing the visualization of temporal distances. Some innovative cartographic representations, such as shrivelled maps, are specifically designed to depict time-space within transport networks where different speeds apply. Representing time-space in maps is a complex challenge, but it also raises questions about how such representations are interpreted and utilized by non-experts. In this study, we examined the impact of different geographic map formats on cognitive tasks requiring judgments of spatial distance or temporal duration in naïve participants. The behavioral results supported the hypothesis that different map formats exert distinct influences on the cognitive processes involved in these tasks. Additionally, the data suggested that shrivelled maps have the potential to facilitate the selection of optimal routes based on travel time, particularly in complex scenarios, given adequate training.},
  keywords = {Anamorphosis,Cartography,Route Selection,Shrivelled Maps,Space and Time Perception,Spatial Cognition},
  annotation = {HAL:hal-05044455},
  file = {/home/lhostis/Zotero/storage/6DSBJAJC/Lhuillier et al. - 2025 - The influence of different cartographic materials on the cognitive processing of geographical time-s.pdf}
}

